# Copy to .env and fill in. NEVER commit .env.

# --- Database ---
# Local dev default is SQLite (no server needed). For prod use the Supabase/Postgres URL:
# SGT_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
SGT_DATABASE_URL=sqlite:///sgt.db

# --- Reddit (official API, register an app at https://www.reddit.com/prefs/apps) ---
SGT_REDDIT_CLIENT_ID=
SGT_REDDIT_CLIENT_SECRET=
SGT_REDDIT_USER_AGENT=sgt:statistical-grounded-trader:0.1.0 (by /u/yourname)

# Comma-separated subreddits to collect.
SGT_REDDIT_SUBREDDITS=wallstreetbets,stocks,investing,options,StockMarket

# --- Salt for hashing Reddit usernames at rest (set to a random secret) ---
SGT_AUTHOR_HASH_SALT=change-me

# --- Sentiment model ---
SGT_SENTIMENT_MODEL=ProsusAI/finbert
# If torch/transformers not installed, pipeline falls back to a deterministic lexicon.
SGT_SENTIMENT_BACKEND=auto   # auto | finbert | lexicon

# --- Backtest cost model (basis points, round-trip) ---
SGT_COST_BPS=10
