<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Forward paper test of the daily per-ticker models (virtual ledger, no orders).
     Rendered by scripts/install_megacap_daily.sh. Weekdays 08:30 (train month models if missing)
     and 15:50 (write today's decisions). Local time must be US Eastern (the installer checks). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.sgt.megacap-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd "__REPO__" &amp;&amp; PYTHONPATH=src:scripts .venv/bin/python scripts/megacap_forward.py auto &gt;&gt; reports/megacap_forward/run.log 2&gt;&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
__INTERVALS__
  </array>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
